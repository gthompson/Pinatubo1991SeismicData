{
  "data_top": "~/Library/CloudStorage/Box-Box/thompsong/DATA/pinatubo1991",
  "output_root": "~/work/Pinatubo1991Processing/utc",
  "time_basis": "utc",
  "clock_regimes": "clock_regimes.csv",
  "network": "XB",
  "database": "PNTBO",
  "waveform": {
    "sampling_rate": null,
    "rate_max_denominator": 100,
    "pattern": "**/*.DMX",
    "max_files": null,
    "overwrite": false,
    "verbose": false,
    "recover_partial": true
  },
  "legacy_bob": {
    "cospec": {
      "units": "t/day",
